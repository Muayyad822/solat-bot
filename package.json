{
  "name": "nidaa",
  "version": "1.0.0",
  "description": "Nidaa (نِدَاء) - The gentle call to prayer. Your silent mu'adhin for Telegram and WhatsApp.",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --esm --respawn --transpile-only src/index.ts",
    "dev": "node --loader ts-node/esm --watch src/index.ts",
    "test": "npm run build && node --test dist/tests/**/*.test.js"
  },
  "keywords": [
    "solat",
    "prayer-times",
    "adhan",
    "nidaa",
    "nidaabot",
    "telegram-bot",
    "whatsapp-bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/tasks": "^5.5.0",
    "adhan": "^4.4.3",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "geo-tz": "^8.0.3",
    "grammy": "^1.34.0",
    "luxon": "^3.5.0",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
